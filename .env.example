# Copy to .env (git-ignored). Never commit real values.

# --- HubSpot: dedicated Bench Outreach account (Tek Ninjas, portal 247408852) ---
# Webhook signature check — client secret of the private app "Agent-Gateway-Bench" → Auth tab.
HUBSPOT_APP_CLIENT_SECRET=

# Agent access to HubSpot goes ONLY through HubSpot's hosted MCP (mcp.hubspot.com).
# Create an MCP connector in HubSpot → Development → MCP Connectors with Redirect URL
# = HUBSPOT_MCP_REDIRECT_URI, then paste its credentials here and run
# `python scripts/hubspot_auth.py` once. Tokens land in .hubspot_mcp_tokens.json (git-ignored).
HUBSPOT_MCP_CLIENT_ID=
HUBSPOT_MCP_CLIENT_SECRET=
HUBSPOT_MCP_REDIRECT_URI=http://localhost:8765/callback
# HUBSPOT_MCP_URL=https://mcp.hubspot.com
# HUBSPOT_MCP_TOKEN_FILE=.hubspot_mcp_tokens.json

# --- Agent Gateway ---
# The public origin HubSpot posts to (e.g. your ngrok URL). Must match exactly —
# it is part of what HubSpot signs.
GATEWAY_PUBLIC_URL=
# Where a routed trigger is handed off. Leave blank until the next agent exists:
# decisions are then appended to logs/gateway/outbox.jsonl instead of being lost.
NEXT_AGENT_URL=
# Local dev ONLY — skips signature verification. Never set in a deployed gateway.
# GATEWAY_SKIP_SIGNATURE=true

# --- Email Agent ---
ANTHROPIC_API_KEY=                # Claude writes each email
EMAIL_AGENT_SEND=false            # MUST stay false until drafts have been reviewed
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=                     # must be on MAILGUN_DOMAIN
MAILGUN_REPLY_TO=                 # optional

# ---- Logging Spec v3.0 -------------------------------------------------
# The three settings (§1). NONE of these may be set in .env itself: an env
# file beats every other source, and a pinned value there makes every other
# way of setting it look broken. Set them in the shell for one run.
#   LOG_DIR=logs/gateway        # where the three files go
#   LOG_MODE=normal             # terse | normal | debug
#   SERVICE_NAME=gateway        # overrides the name the service binds
